<Window x:Class="RtFileMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT File Monitor" Width="1160" Height="760" MinWidth="800" MinHeight="540"
        Background="#EEF2F6" Foreground="#182637" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#122338" Padding="24,17">
            <TextBlock x:Name="AppHeading" Text="ChatGPT File Monitor" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border DockPanel.Dock="Top" Margin="20,16,20,0" Padding="16,12" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="126"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="8"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text=".Codex folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ActivityFolder" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Column="2" Content="Choose folder…" Click="ChooseActivity" AutomationProperties.Name="Choose .Codex folder"/>
                <Button Grid.Column="3" Content="Select default" Click="ChooseDefaultActivity" Margin="8,0,0,0"
                        AutomationProperties.Name="Select default .Codex folder"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActivityStatus" Foreground="#A12622" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="Codex JSONL sessions folder" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessionFolder" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Row="3" Grid.Column="2" Content="Choose folder…" Click="ChooseSessions" AutomationProperties.Name="Choose Codex JSONL sessions folder"/>
                <Button Grid.Row="3" Grid.Column="3" Content="Select default" Click="ChooseDefaultSessions" Margin="8,0,0,0"
                        AutomationProperties.Name="Select default Codex JSONL sessions folder"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SessionStatus" Foreground="#A12622" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Grid.ColumnSpan="4" x:Name="SettingsStatus" Foreground="#A12622" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <TabControl Margin="20,14,20,20" Background="White">
            <TabItem Header=".codex folder">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" x:Name="ActivityEmpty" Margin="0,0,0,10"
                               Text="Choose a folder to see file updates here." Foreground="#4A5C70"/>
                    <DataGrid x:Name="ActivityGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E3EAF1" AlternatingRowBackground="#F4F7FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*"/>
                            <DataGridTextColumn Header="Date modified" Binding="{Binding Modified, StringFormat=G}" Width="1.5*"/>
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size, StringFormat=N0}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="JSONL sessions">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sessions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Button DockPanel.Dock="Top" x:Name="LoadPreviousButton" Content="Load previous sessions"
                                Click="LoadPreviousSessions" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="PreviousSessionsStatus" TextWrapping="Wrap"
                                   Foreground="#4A5C70" Margin="0,0,0,8"/>
                        <ListBox x:Name="SessionList" SelectionChanged="SelectSession"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding RelativePath}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#E3EAF1"/>
                    <DockPanel Grid.Column="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="126"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="_Search" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="FilterChanged"/>
                            <Label Grid.Column="2" Content="_Type" Target="{Binding ElementName=CategoryBox}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="3" x:Name="CategoryBox" SelectionChanged="FilterChanged" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" x:Name="TimelineStatus" Margin="0,0,0,8" Foreground="#4A5C70" TextWrapping="Wrap"/>
                        <ListBox x:Name="Timeline" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,9" BorderBrush="#E3EAF1" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="#4A5C70" Margin="12,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Category}" Foreground="#285C91" Width="100"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" TextWrapping="Wrap" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                                     Visibility="{Binding HasSummary, Converter={StaticResource VisibleWhenTrue}}"/>
                                            <Expander Margin="2,5,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Line, StringFormat='JSON · line {0}'}"/>
                                                </Expander.Header>
                                                <TextBox IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                                                         MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding PrettyJson, Mode=OneWay}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
