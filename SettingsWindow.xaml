<Window x:Class="RtFileMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#EEF2F6" Foreground="#182637" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="20" Padding="20" Background="White" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Codex" FontSize="20" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="SQLite" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,8"
                       AutomationProperties.HeadingLevel="Level2"/>
            <StackPanel Margin="12,0,0,0">
                <StackPanel.Resources>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <CheckBox><TextBlock Text=".codex-global-state.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="goals_1.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="logs_2.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="memories_1.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="queue_1.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="state_5.sqlite"/></CheckBox>
                <CheckBox><TextBlock Text="thread_history_1.sqlite"/></CheckBox>
            </StackPanel>
            <Button Content="Close" IsCancel="True" HorizontalAlignment="Right"
                    Padding="14,6" MinHeight="32" Cursor="Hand" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
