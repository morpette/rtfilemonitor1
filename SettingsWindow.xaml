<Window x:Class="RtFileMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#EEF2F6" Foreground="#182637" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="20" Padding="20" Background="White" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Codex" FontSize="20" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text=".codex folder" FontWeight="SemiBold" Margin="0,12,0,2"/>
            <TextBlock Text="{Binding ActivityFolder.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityFolder.Text}"/>
            <TextBlock Text="{Binding ActivityStatus.Text}" TextWrapping="Wrap" Foreground="#A12622"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="ChooseActivityButton" Content="Choose folder&#x2026;" Padding="10,4"
                        AutomationProperties.Name="Choose .codex folder"/>
                <Button x:Name="DefaultActivityButton" Content="Use default" Padding="10,4" Margin="8,0,0,0"
                        AutomationProperties.Name="Use default .codex folder"/>
            </StackPanel>
            <TextBlock Text="JSONL sessions folder" FontWeight="SemiBold" Margin="0,12,0,2"/>
            <TextBlock Text="{Binding SessionFolder.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionFolder.Text}"/>
            <TextBlock Text="{Binding SessionStatus.Text}" TextWrapping="Wrap" Foreground="#A12622"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="ChooseSessionsButton" Content="Choose folder&#x2026;" Padding="10,4"
                        AutomationProperties.Name="Choose JSONL sessions folder"/>
                <Button x:Name="DefaultSessionsButton" Content="Use default" Padding="10,4" Margin="8,0,0,0"
                        AutomationProperties.Name="Use default JSONL sessions folder"/>
            </StackPanel>
            <Label Content="Session _entry order" Target="{Binding ElementName=TimelineOrder}" Padding="0" Margin="0,12,0,4"
                   FontWeight="SemiBold"/>
            <ComboBox x:Name="TimelineOrder" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="150">
                <ComboBoxItem Content="Newest first"/>
                <ComboBoxItem Content="Oldest first"/>
            </ComboBox>
            <TextBlock Text="{Binding SettingsStatus.Text}" TextWrapping="Wrap" Foreground="#A12622"/>
            <TextBlock Text="SQLite" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,8"
                       AutomationProperties.HeadingLevel="Level2"/>
            <StackPanel Margin="12,0,0,0">
                <StackPanel.Resources>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="ToggleDatabasesButton" Click="ToggleDatabases" HorizontalAlignment="Left"
                        Padding="12,5" MinHeight="32" Cursor="Hand" Margin="0,0,0,8"/>
                <StackPanel x:Name="DatabaseChecks" CheckBox.Checked="UpdateDatabaseToggle" CheckBox.Unchecked="UpdateDatabaseToggle"/>
                <Button x:Name="MapDatabasesButton" Content="Map databases" Click="MapDatabases"
                        HorizontalAlignment="Left" Padding="12,5" MinHeight="32" Cursor="Hand"/>
                <TextBlock x:Name="MapStatus" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Button Content="Close" IsCancel="True" HorizontalAlignment="Right"
                    Padding="14,6" MinHeight="32" Cursor="Hand" Margin="0,8,0,0"/>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
